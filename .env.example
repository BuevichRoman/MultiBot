# Настройки запуска бота. Скопировать в .env — он не коммитится.
# Прогон тестов настраивается отдельно, см. tests/.env.example

# Мониторинг ошибок. Без DSN он выключен целиком: ничего не отправляется,
# поведение прежнее. Логи пишутся в любом случае
SENTRY_DSN=
# Окружение в событиях: production, stand, development.
# По умолчанию берётся NODE_ENV
SENTRY_ENV=
# Версия сборки в событиях, необязательна
SENTRY_RELEASE=
