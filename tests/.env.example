# Настройки прогона tests/test_adapter_neworch.ts.
# Скопировать в tests/.env и заполнить своими значениями.
# Реальные доступы в репозиторий не коммитим — он публичный.

# Адрес API. Для прогона против локального мока — http://localhost:4010/api/v1/
MULTIBOT_API_URL=http://localhost:4010/api/v1/

# Учётная запись администратора, от имени которой ходит APIManager
MULTIBOT_ADMIN_LOGIN=
MULTIBOT_ADMIN_PASSWORD=

# Redis. Пустой пароль допустим — значит подключение без пароля.
# Для прогона против мока лучше отдельный экземпляр: тест очищает базу
MULTIBOT_REDIS_HOST=127.0.0.1
MULTIBOT_REDIS_PORT=6380
MULTIBOT_REDIS_PASSWORD=

# Токен Telegram-бота. Нужен только когда MULTIBOT_ADAPTER_ONLY не выставлен:
# при MULTIBOT_ADAPTER_ONLY=1 Telegram и WhatsApp не поднимаются вовсе
MULTIBOT_TELEGRAM_TOKEN=

# 1 — гонять только через TestAdapter, не подключаясь к настоящему боту
MULTIBOT_ADAPTER_ONLY=1
